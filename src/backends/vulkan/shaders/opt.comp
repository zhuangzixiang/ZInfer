#version 450
// 优化器步进: OPT 0=SGD(momentum) 1=Adam —— 与 CUDA sgd_k/adam_k 同构
layout(local_size_x = 256) in;

layout(constant_id = 0) const int OPT = 0;

layout(binding = 0) buffer P  { float p[]; };
layout(binding = 1) buffer G  { float g[]; };
layout(binding = 2) buffer U1 { float u1[]; };   // sgd: vel / adam: m
layout(binding = 3) buffer U2 { float u2[]; };   // adam: v(sgd 不绑)

layout(push_constant) uniform Pc {
    int n;
    float lr;
    float p1;   // sgd: momentum / adam: b1
    float p2;   // sgd: weight_decay / adam: b2
    float p3;   // adam: eps
    float p4;   // adam: weight_decay
    float p5;   // adam: bias1
    float p6;   // adam: bias2
    float p7;   // adamw: decoupled decay
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    if (OPT == 0) {
        if (pc.p1 > 0.0) {
            u1[i] = pc.p1 * u1[i] + g[i] + pc.p2 * p[i];
            p[i] -= pc.lr * u1[i];
        } else {
            p[i] -= pc.lr * (g[i] + pc.p2 * p[i]);
        }
    } else {
        const float grad = g[i] + pc.p4 * p[i];
        u1[i] = pc.p1 * u1[i] + (1.0 - pc.p1) * grad;
        u2[i] = pc.p2 * u2[i] + (1.0 - pc.p2) * grad * grad;
        const float mh = u1[i] / pc.p5;
        const float vh = u2[i] / pc.p6;
        p[i] = p[i] * (1.0 - pc.lr * pc.p7) - pc.lr * mh / (sqrt(vh) + pc.p3);
    }
}
