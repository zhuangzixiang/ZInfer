#version 450
// 任意维规约(sum/mean): 每 workgroup 负责一个输出, 线程沿 dim 协作
// 累加 + 共享内存树归约(固定归约序 → 确定性)。此前一线程一输出串行
// 扫全维, 输出数少(dim0/标量)时整卡只有零星线程在跑。
layout(local_size_x = 256) in;

layout(constant_id = 0) const int RANK = 1;    // 去掉规约维后的秩
layout(constant_id = 1) const int MEAN = 0;    // 1 = 结果 × 1/n

layout(binding = 0) readonly buffer Xbuf { float x[]; };
layout(binding = 2) writeonly buffer Ybuf { float y[]; };

layout(push_constant) uniform Pc {
    int total;          // 输出元素数
    int n_dim;          // 规约维长度 K
    int s_dim;          // 规约维输入步长
    int odims[8];       // 输出各维尺寸
    int xstr[8];        // 输入对应步长
} pc;

shared float sh[256];

void main() {
    const int o = int(gl_WorkGroupID.x);
    if (o >= pc.total) return;
    int t = o;
    int base = 0;
    for (int d = RANK - 1; d >= 0; --d) {
        base += (t % pc.odims[d]) * pc.xstr[d];
        t /= pc.odims[d];
    }
    float acc = 0.0;
    for (int j = int(gl_LocalInvocationID.x); j < pc.n_dim; j += 256) {
        acc += x[base + j * pc.s_dim];
    }
    sh[gl_LocalInvocationID.x] = acc;
    barrier();
    for (int s = 128; s > 0; s >>= 1) {
        if (int(gl_LocalInvocationID.x) < s) {
            sh[gl_LocalInvocationID.x] += sh[gl_LocalInvocationID.x + s];
        }
        barrier();
    }
    if (gl_LocalInvocationID.x == 0) {
        y[o] = (MEAN == 1) ? sh[0] / float(pc.n_dim) : sh[0];
    }
}
