#version 450
// 任意维规约(sum/mean): 每线程规约沿 dim 的 K 个元素(行距 s_dim),
// 输出多下标由 Map 结构等价的步长表计算(与 CUDA 版同构)
layout(local_size_x = 256) in;

layout(constant_id = 0) const int RANK = 1;    // 去掉规约维后的秩
layout(constant_id = 1) const int MEAN = 0;    // 1 = 结果 × 1/n

layout(binding = 0) readonly buffer Xbuf { float x[]; };
layout(binding = 2) writeonly buffer Ybuf { float y[]; };

layout(push_constant) uniform Pc {
    int total;          // 输出元素数
    int n_dim;          // 规约维长度 K
    int s_dim;          // 规约维输入步长
    int odims[8];       // 输出各维尺寸
    int xstr[8];        // 输入对应步长
} pc;

void main() {
    const int o = int(gl_GlobalInvocationID.x);
    if (o >= pc.total) return;
    int t = o;
    int base = 0;
    for (int d = RANK - 1; d >= 0; --d) {
        base += (t % pc.odims[d]) * pc.xstr[d];
        t /= pc.odims[d];
    }
    float acc = 0.0;
    for (int j = 0; j < pc.n_dim; ++j) {
        acc += x[base + j * pc.s_dim];
    }
    y[o] = (MEAN == 1) ? acc / float(pc.n_dim) : acc;
}
